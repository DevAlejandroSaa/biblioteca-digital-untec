<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
    version="4.0">

    <display-name>Biblioteca Digital UNTEC</display-name>

    <!-- Login -->

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>cl.untec.controller.LoginServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>


    <!-- Catálogo -->

    <servlet>
        <servlet-name>LibroServlet</servlet-name>
        <servlet-class>cl.untec.controller.LibroServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LibroServlet</servlet-name>
        <url-pattern>/libros</url-pattern>
    </servlet-mapping>


    <!-- Vista estudiante -->

    <servlet>
        <servlet-name>EstudianteServlet</servlet-name>
        <servlet-class>cl.untec.controller.EstudianteServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>EstudianteServlet</servlet-name>
        <url-pattern>/estudiante</url-pattern>
    </servlet-mapping>


    <!-- Vista personal -->

    <servlet>
        <servlet-name>PersonalServlet</servlet-name>
        <servlet-class>cl.untec.controller.PersonalServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>PersonalServlet</servlet-name>
        <url-pattern>/personal</url-pattern>
    </servlet-mapping>


    <!-- Filtro de autenticación -->

    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>cl.untec.filter.AuthFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/libros</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/estudiante</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/personal</url-pattern>
    </filter-mapping>


    <!-- Configuración de sesión -->

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>